# Copy to .env and fill in. Never commit the filled file.

# --- Google sign-in (required) ---
# OAuth "Web application" client. Authorized redirect URI:
#   http://localhost:5173/api/v1/auth/google/callback
MYANIME_GOOGLE_CLIENT_ID=
MYANIME_GOOGLE_CLIENT_SECRET=

# Allowlist. At least one is required; an empty list denies everyone.
MYANIME_GOOGLE_ALLOWED_EMAILS=
# MYANIME_GOOGLE_ALLOWED_DOMAINS=

# --- Desktop OAuth client (optional) ---
# OAuth "Desktop app" client. Google only allows loopback redirects for these.
# MYANIME_GOOGLE_DESKTOP_CLIENT_ID=
# MYANIME_GOOGLE_DESKTOP_CLIENT_SECRET=

# --- Local development ---
MYANIME_DEV=1
MYANIME_DEV_ORIGIN=http://localhost:5173

# --- Storage ---
# MYANIME_DATA_DIR=./data

# --- Production ---
# MYANIME_PUBLIC_ORIGIN=https://your-host
# MYANIME_TRUSTED_PROXIES=
# MYANIME_BEHIND_TLS_PROXY=1
