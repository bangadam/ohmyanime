{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"files": {
		"includes": ["src/**", "*.ts", "*.json"]
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"useExhaustiveDependencies": "off",
				"noComponentHookFactories": "off"
			},
			"suspicious": {
				"noArrayIndexKey": "off",
				"useIterableCallbackReturn": "off"
			},
			"a11y": {
				"useSemanticElements": "off",
				"useKeyWithClickEvents": "off",
				"noStaticElementInteractions": "off",
				"useMediaCaption": "off"
			}
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "off"
			}
		}
	},
	"vcs": {
		"enabled": false
	}
}
